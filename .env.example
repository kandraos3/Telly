# ==============================================================================
# TELLY ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env and populate with your credentials.
# ==============================================================================

# --- APPLICATION & RUNTIME ---
APP_ENV=development                         # development | staging | production
APP_NAME=Telly
APP_URL=https://telly.app
API_BASE_URL=https://api.telly.app/v1
PORT=8080

# --- SUPABASE BACKEND & DATABASE ---
# Found in: Supabase Dashboard -> Project Settings -> API
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
DATABASE_URL=postgresql://postgres:your-db-password@db.your-project-id.supabase.co:5432/postgres

# --- REDIS IN-MEMORY CACHE ---
# Upstash or Redis Cloud connection URL
REDIS_URL=rediss://default:your-redis-password@your-redis-host.upstash.io:6379

# --- TMDB (THE MOVIE DATABASE) API ---
# Registered at: https://www.themoviedb.org/settings/api
TMDB_API_KEY=your_tmdb_api_key_v3
TMDB_READ_ACCESS_TOKEN=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# --- JUSTWATCH / WATCHMODE STREAMING AVAILABILITY ---
# Registered at: https://api.watchmode.com/ or JustWatch Partner API
WATCHMODE_API_KEY=your_watchmode_api_key

# --- TWILIO SMS AUTHENTICATION ---
# Required for SMS OTP verification
TWILIO_ACCOUNT_SID=ACXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_VERIFY_SERVICE_SID=VAXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# --- PUSH NOTIFICATIONS ---
# OneSignal or Firebase Cloud Messaging
ONESIGNAL_APP_ID=your-onesignal-app-id
ONESIGNAL_REST_API_KEY=your-onesignal-rest-api-key
FCM_SERVER_KEY=your-firebase-server-key

# --- MONITORING & TELEMETRY ---
SENTRY_DSN=https://your-sentry-dsn@o12345.ingest.sentry.io/67890
POSTHOG_API_KEY=phc_your_posthog_client_api_key
POSTHOG_HOST=https://app.posthog.com

# --- APPLE & GOOGLE OAUTH ---
APPLE_SERVICE_ID=app.telly.mobile.signin
APPLE_TEAM_ID=XXXXXXXXXX
APPLE_KEY_ID=XXXXXXXXXX
GOOGLE_CLIENT_ID_IOS=your-ios-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_ID_ANDROID=your-android-google-client-id.apps.googleusercontent.com
